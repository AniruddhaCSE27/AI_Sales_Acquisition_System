# LeadForge AI environment template. Do not commit real secrets.
APP_NAME=LeadForge AI
ENVIRONMENT=production
API_V1_PREFIX=/api/v1
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
DATABASE_URL=postgresql+psycopg://leadforge:replace-password@postgres:5432/leadforge
REDIS_URL=redis://redis:6379/0
REQUIRE_REDIS_FOR_READINESS=true
SEED_DEMO_DATA=false
SEED_DEFAULT_PASSWORD=Password123!
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_REDIS_PREFIX=leadforge:rate_limit
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DEEPGRAM_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_STREAM_PATH=/api/v1/ws/twilio/media
TWILIO_MAX_RETRIES=3
WHISPER_MODEL=whisper-1
MODEL_REGISTRY_DIR=/app/ai_models/registry
VECTOR_DB_DIR=/app/ai_models/vector_db
RAG_BACKEND=auto
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
PUBLIC_BASE_URL=https://leadforge.example.com
REPORTS_DIR=/app/reports
UPLOADS_DIR=/app/uploads
CORS_ORIGINS=["https://leadforge.example.com"]
NEXT_PUBLIC_API_URL=https://leadforge.example.com/api/v1
NEXT_PUBLIC_WS_URL=wss://leadforge.example.com/api/v1/ws
